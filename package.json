{
  "name": "undead-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Realistic browser character lab / game foundation (three.js + Vite)",
  "scripts": {
    "assets": "node tools/fetch-assets.mjs",
    "predev": "node tools/fetch-assets.mjs",
    "dev": "vite --host",
    "prebuild": "node tools/fetch-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --host --port 4173",
    "inspect": "node tools/inspect-glb.mjs",
    "lint": "eslint .",
    "test:screens": "node tests/screenshots.cjs && node tests/play.cjs && node tests/shoot.cjs",
    "test:play": "node tests/play.cjs",
    "test:shoot": "node tests/shoot.cjs",
    "osm": "node tools/fetch-osm.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "draco3dgltf": "1.5.9",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "vite": "7.3.8"
  },
  "engines": {
    "node": ">=20"
  }
}
